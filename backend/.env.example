PORT=5001

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=soil_irrigation

# Moisture percentage below which a zone is flagged for watering
# (fallback default only -- each zone's own moisture_threshold column takes
# precedence once set; see migrations/002_add_zone_moisture_threshold.sql)
MOISTURE_THRESHOLD=30

# Minimum minutes between auto-triggered watering events for the same zone.
# Prevents re-firing a relay/pump on every reading while a zone stays below
# threshold -- see src/utils/irrigationAdvisor.js for why this matters.
IRRIGATION_COOLDOWN_MINUTES=10

# How often (ms) the simulator generates a new reading per zone
SIMULATOR_INTERVAL_MS=5000
